<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ruta de Aprendizaje LSM"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- SELECTOR DE SECCIÓN (Abecedario / Números) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <Button
                android:id="@+id/btnCatAbecedario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔤 Abecedario"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnCatNumeros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔢 Números"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- CAMINO DE NIVELES (5 ACTIVIDADES) -->

        <!-- Actividad 1: Introducción -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabNivel1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_agenda"
            app:backgroundTint="#E91E63"
            android:layout_marginBottom="24dp"
            android:contentDescription="Nivel 1" />

        <!-- Actividad 2: Identificar señas -->

        <!-- Actividad 3: Seleccionar seña (Letra) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabNivel2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="Nivel 2"
            android:src="@android:drawable/ic_menu_camera"
            app:backgroundTint="#9C27B0" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabNivel3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_compass"
            app:backgroundTint="#3F51B5"
            android:layout_marginBottom="24dp"
            android:layout_marginEnd="40dp"
            android:contentDescription="Nivel 3" />

        <!-- Actividad 4: Seleccionar seña (Práctica) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabNivel4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_manage"
            app:backgroundTint="#00BCD4"
            android:layout_marginBottom="24dp"
            android:contentDescription="Nivel 4" />

        <!-- Actividad 5: Escribir palabra con señas -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabNivel5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_edit"
            app:backgroundTint="#FF9800"
            android:layout_marginBottom="24dp"
            android:layout_marginStart="40dp"
            android:contentDescription="Nivel 5" />

    </LinearLayout>
</ScrollView>